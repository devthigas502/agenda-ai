<div class="max-w-2xl mx-auto space-y-8" data-controller="booking">
  <!-- Business Header Info -->
  <div class="text-center space-y-2">
    <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight"><%= @account.name %></h1>
    <p class="text-slate-600 dark:text-slate-400 text-sm">Selecione o serviço e horário desejado para agendar sua reserva em poucos segundos.</p>
  </div>

  <% if alert %>
    <div class="p-4 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 text-sm text-center font-medium">
      <%= alert %>
    </div>
  <% end %>

  <% if @account.subscribed? %>
    <%= form_with scope: :booking, url: public_bookings_path(slug: @account.slug), id: "booking-form", class: "space-y-6" do |f| %>
      <!-- Step 1: Select Service -->
      <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900/70 border border-slate-200/90 dark:border-slate-800 backdrop-blur-xl shadow-sm dark:shadow-none transition-colors">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold flex items-center justify-center text-sm border border-indigo-500/20">1</div>
          <h3 class="font-bold text-base text-slate-900 dark:text-white">Escolha o Serviço</h3>
        </div>

        <div class="space-y-3">
          <% @services.each_with_index do |service, idx| %>
            <label class="block cursor-pointer group">
              <input type="radio" name="booking[service_id]" value="<%= service.id %>" class="peer sr-only" required <%= "checked" if idx.zero? %> data-action="change->booking#updateSlots">
              <div class="p-4 rounded-2xl bg-slate-50/70 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 peer-checked:border-indigo-600 dark:peer-checked:border-indigo-500 peer-checked:bg-indigo-50/70 dark:peer-checked:bg-indigo-950/30 peer-checked:ring-2 peer-checked:ring-indigo-500/30 transition-all flex items-center justify-between">
                <div>
                  <span class="font-bold text-sm text-slate-900 dark:text-white block group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"><%= service.name %></span>
                  <% if service.description.present? %>
                    <span class="text-xs text-slate-500 dark:text-slate-400 block mt-0.5"><%= service.description %></span>
                  <% end %>
                  <span class="text-xs text-slate-500 dark:text-slate-400 mt-1 block">⏱ <%= service.formatted_duration %></span>
                </div>
                <div class="text-right">
                  <span class="font-extrabold text-base text-emerald-600 dark:text-emerald-400 block"><%= service.formatted_price %></span>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Step 2: Select Professional -->
      <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900/70 border border-slate-200/90 dark:border-slate-800 backdrop-blur-xl shadow-sm dark:shadow-none transition-colors">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold flex items-center justify-center text-sm border border-indigo-500/20">2</div>
          <h3 class="font-bold text-base text-slate-900 dark:text-white">Escolha o Profissional</h3>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <% @professionals.each_with_index do |prof, idx| %>
            <label class="block cursor-pointer group">
              <input type="radio" name="booking[professional_id]" value="<%= prof.id %>" class="peer sr-only" required <%= "checked" if idx.zero? %> data-action="change->booking#updateSlots">
              <div class="p-4 rounded-2xl bg-slate-50/70 dark:bg-slate-950/60 border border-slate-200 dark:border-slate-800/80 peer-checked:border-indigo-600 dark:peer-checked:border-indigo-500 peer-checked:bg-indigo-50/70 dark:peer-checked:bg-indigo-950/30 peer-checked:ring-2 peer-checked:ring-indigo-500/30 transition-all flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-indigo-100 dark:bg-slate-800 flex items-center justify-center font-bold text-indigo-700 dark:text-white text-sm">
                  <%= prof.name.first %>
                </div>
                <div>
                  <span class="font-bold text-sm text-slate-900 dark:text-white block group-hover:text-indigo-600 dark:group-hover:text-indigo-400 transition-colors"><%= prof.name %></span>
                  <span class="text-xs text-slate-500 dark:text-slate-400 block">Atendimento profissional</span>
                </div>
              </div>
            </label>
          <% end %>
        </div>
      </div>

      <!-- Step 3: Date and Time Slot Picker -->
      <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900/70 border border-slate-200/90 dark:border-slate-800 backdrop-blur-xl shadow-sm dark:shadow-none transition-colors">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold flex items-center justify-center text-sm border border-indigo-500/20">3</div>
          <h3 class="font-bold text-base text-slate-900 dark:text-white">Selecione a Data e Horário</h3>
        </div>

        <div class="space-y-4">
          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Data da Reserva</label>
            <input type="date" id="booking_date_picker" value="<%= Date.tomorrow.strftime("%Y-%m-%d") %>" min="<%= Date.today.strftime("%Y-%m-%d") %>" max="<%= (Date.today + 30.days).strftime("%Y-%m-%d") %>" class="w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-medium transition-colors" data-action="change->booking#updateSlots">
          </div>

          <div>
            <label class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Horários Disponíveis</label>
            <div id="slots_container" class="grid grid-cols-3 sm:grid-cols-4 gap-2.5 min-h-[60px]">
              <p class="col-span-full text-xs text-slate-500 dark:text-slate-400 py-4 text-center">Carregando horários disponíveis...</p>
            </div>
            <input type="hidden" name="booking[starts_at]" id="selected_starts_at" required>
          </div>
        </div>
      </div>

      <!-- Step 4: Client Info -->
      <div class="p-6 sm:p-7 rounded-3xl bg-white dark:bg-slate-900/70 border border-slate-200/90 dark:border-slate-800 backdrop-blur-xl shadow-sm dark:shadow-none transition-colors">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-full bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 font-bold flex items-center justify-center text-sm border border-indigo-500/20">4</div>
          <h3 class="font-bold text-base text-slate-900 dark:text-white">Seus Dados de Contato</h3>
        </div>

        <div class="space-y-4">
          <div>
            <%= f.label :client_name, "Seu Nome Completo", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
            <%= f.text_field :client_name, required: true, placeholder: "Ex: Maria Oliveira", class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <%= f.label :client_phone, "Telefone / WhatsApp", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
              <%= f.telephone_field :client_phone, required: true, placeholder: "(11) 99999-9999", class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
            </div>

            <div>
              <%= f.label :client_email, "E-mail para Confirmação", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
              <%= f.email_field :client_email, placeholder: "seu@email.com", class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
            </div>
          </div>
        </div>
      </div>

      <!-- Submit CTA -->
      <div class="pt-2">
        <button type="submit" id="submit_booking_btn" disabled class="w-full py-4 px-6 rounded-2xl font-bold text-white bg-gradient-to-r from-indigo-500 via-violet-600 to-purple-600 opacity-50 cursor-not-allowed transition-all text-base shadow-xl shadow-indigo-500/25">
          Selecione um Horário para Confirmar
        </button>
      </div>
    <% end %>
  <% else %>
    <!-- Notice when account subscription / trial has expired -->
    <div class="p-8 sm:p-12 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800 text-center space-y-4 shadow-sm dark:shadow-2xl backdrop-blur-xl">
      <div class="w-16 h-16 rounded-2xl bg-amber-500/10 text-amber-600 dark:text-amber-400 flex items-center justify-center mx-auto border border-amber-500/20">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      </div>
      <h2 class="text-xl font-extrabold text-slate-900 dark:text-white">Agendamentos Temporariamente Indisponíveis</h2>
      <p class="text-sm text-slate-600 dark:text-slate-400 max-w-md mx-auto leading-relaxed">
        A agenda online deste estabelecimento está temporariamente indisponível para novas reservas. Por favor, entre em contato diretamente com o estabelecimento para mais informações.
      </p>
      <% if @account.phone.present? %>
        <div class="pt-2">
          <a href="tel:<%= @account.phone %>" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl font-semibold text-sm bg-indigo-50 dark:bg-indigo-950/40 text-indigo-600 dark:text-indigo-300 hover:bg-indigo-100 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <%= @account.phone %>
          </a>
        </div>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Inline JavaScript for Slot Fetching & Interactivity -->
<script>
  document.addEventListener("turbo:load", initBookingPage);
  document.addEventListener("DOMContentLoaded", initBookingPage);

  function initBookingPage() {
    const datePicker = document.getElementById("booking_date_picker");
    if (!datePicker) return;

    datePicker.addEventListener("change", fetchSlots);

    const radios = document.querySelectorAll("input[type=radio]");
    radios.forEach(r => r.addEventListener("change", fetchSlots));

    fetchSlots();
  }

  async function fetchSlots() {
    const serviceRadio = document.querySelector("input[name='booking[service_id]']:checked");
    const profRadio = document.querySelector("input[name='booking[professional_id]']:checked");
    const datePicker = document.getElementById("booking_date_picker");
    const container = document.getElementById("slots_container");
    const submitBtn = document.getElementById("submit_booking_btn");
    const hiddenStartsAt = document.getElementById("selected_starts_at");

    if (!serviceRadio || !profRadio || !datePicker) return;

    container.innerHTML = '<p class="col-span-full text-xs text-slate-500 dark:text-slate-400 py-3 text-center">Buscando horários...</p>';
    hiddenStartsAt.value = "";
    submitBtn.disabled = true;
    submitBtn.classList.add("opacity-50", "cursor-not-allowed");
    submitBtn.textContent = "Selecione um Horário para Confirmar";

    try {
      const url = `/<%= @account.slug %>/slots?service_id=${serviceRadio.value}&professional_id=${profRadio.value}&date=${datePicker.value}`;
      const resp = await fetch(url);
      const data = await resp.json();

      if (data.slots && data.slots.length > 0) {
        container.innerHTML = data.slots.map(s => `
          <button type="button" data-starts-at="${s.starts_at}" onclick="selectSlot(this, '${s.starts_at}')" class="slot-btn py-2.5 px-3 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/80 dark:bg-slate-950/80 text-slate-700 dark:text-slate-200 text-xs font-mono font-semibold hover:border-indigo-500 hover:text-indigo-600 dark:hover:text-white transition-all text-center cursor-pointer shadow-xs">
            ${s.formatted}
          </button>
        `).join("");
      } else {
        container.innerHTML = '<p class="col-span-full text-xs text-amber-600 dark:text-amber-400 py-3 text-center font-medium">Sem horários disponíveis para esta data. Escolha outro dia ou profissional.</p>';
      }
    } catch (e) {
      container.innerHTML = '<p class="col-span-full text-xs text-rose-600 dark:text-rose-400 py-3 text-center font-medium">Erro ao buscar horários.</p>';
    }
  }

  function selectSlot(btn, startsAt) {
    document.querySelectorAll(".slot-btn").forEach(b => {
      b.classList.remove("bg-indigo-600", "text-white", "border-indigo-600", "ring-2", "ring-indigo-400");
      b.classList.add("bg-slate-50/80", "dark:bg-slate-950/80", "text-slate-700", "dark:text-slate-200", "border-slate-200", "dark:border-slate-800");
    });

    btn.classList.remove("bg-slate-50/80", "dark:bg-slate-950/80", "text-slate-700", "dark:text-slate-200", "border-slate-200", "dark:border-slate-800");
    btn.classList.add("bg-indigo-600", "text-white", "border-indigo-600", "ring-2", "ring-indigo-400");

    const hiddenStartsAt = document.getElementById("selected_starts_at");
    hiddenStartsAt.value = startsAt;

    const submitBtn = document.getElementById("submit_booking_btn");
    submitBtn.disabled = false;
    submitBtn.classList.remove("opacity-50", "cursor-not-allowed");
    submitBtn.textContent = "Confirmar Agendamento";
  }
</script>

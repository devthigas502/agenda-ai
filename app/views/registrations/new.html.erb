<div class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col justify-center py-12 px-4 sm:px-6 lg:px-8 relative overflow-hidden transition-colors duration-200">
  <div class="absolute top-6 right-6 z-20">
    <%= render "shared/theme_toggle" %>
  </div>

  <!-- Glow Effect -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-indigo-500/10 dark:bg-indigo-600/15 rounded-full blur-[130px] pointer-events-none"></div>

  <div class="sm:mx-auto sm:w-full sm:max-w-md text-center z-10">
    <a href="/" class="inline-flex items-center gap-3 mb-6">
      <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-500 to-violet-500 flex items-center justify-center shadow-xl shadow-indigo-500/30">
        <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      </div>
      <span class="font-extrabold text-3xl text-slate-900 dark:text-white tracking-tight">Agenda<span class="text-indigo-600 dark:text-indigo-400">AI</span></span>
    </a>
    <h2 class="text-2xl font-bold text-slate-900 dark:text-white tracking-tight">Comece seu teste grátis de 14 dias</h2>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">Configure seu negócio em menos de 2 minutos</p>
  </div>

  <div class="mt-8 sm:mx-auto sm:w-full sm:max-w-md z-10">
    <div class="bg-white dark:bg-slate-900/80 backdrop-blur-xl border border-slate-200/90 dark:border-slate-800 p-8 rounded-3xl shadow-sm dark:shadow-2xl transition-colors">
      <% if @errors&.any? %>
        <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 text-sm">
          <p class="font-semibold mb-1">Atenção:</p>
          <ul class="list-disc list-inside space-y-1">
            <% @errors.each do |err| %>
              <li><%= err %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with(model: @onboarding, as: :onboarding, url: user_registration_path, class: "space-y-5") do |f| %>
        <div>
          <label for="onboarding_account_name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Nome do seu Negócio</label>
          <%= f.text_field :account_name, placeholder: "Ex: Barbearia Silva, Clínica Vida", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <div>
          <label for="onboarding_user_name" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Seu Nome Completo</label>
          <%= f.text_field :user_name, placeholder: "Seu nome", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <div>
          <label for="onboarding_email" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">E-mail Profissional</label>
          <%= f.email_field :email, placeholder: "seu@email.com", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <div>
          <label for="onboarding_phone" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Telefone / WhatsApp</label>
          <%= f.telephone_field :phone, placeholder: "(11) 99999-9999", class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <div>
          <label for="onboarding_password" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Senha de Acesso</label>
          <%= f.password_field :password, placeholder: "Mínimo 6 caracteres", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <div>
          <label for="onboarding_password_confirmation" class="block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2">Confirme sua Senha</label>
          <%= f.password_field :password_confirmation, placeholder: "Repita a senha", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <%= f.submit "Criar Minha Conta", class: "w-full py-3.5 px-4 rounded-xl font-bold text-white bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 shadow-md shadow-indigo-500/25 transition-all cursor-pointer text-sm" %>
      <% end %>

      <div class="mt-6 text-center text-xs text-slate-500 dark:text-slate-400">
        Já tem uma conta?
        <%= link_to "Fazer Login", new_user_session_path, class: "font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-500 dark:hover:text-indigo-300" %>
      </div>
    </div>
  </div>
</div>

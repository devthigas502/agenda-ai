<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-6"><%= @service.persisted? ? "Editar Serviço" : "Novo Serviço" %></h1>

  <div class="bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800 p-8 rounded-3xl backdrop-blur-xl shadow-sm dark:shadow-none transition-colors">
    <%= form_with model: [:admin, @service], class: "space-y-5" do |f| %>
      <div>
        <%= f.label :name, "Nome do Serviço", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
        <%= f.text_field :name, placeholder: "Ex: Corte Masculino, Consulta Inicial", required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
      </div>

      <div>
        <%= f.label :description, "Descrição (opcional)", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
        <%= f.text_area :description, rows: 3, placeholder: "Detalhes sobre o que está incluído no serviço...", class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :duration_minutes, "Duração (em minutos)", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
          <%= f.number_field :duration_minutes, placeholder: "Ex: 30, 45, 60", required: true, min: 5, max: 480, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <div>
          <%= f.label :price_reais, "Preço (R$)", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
          <%= f.number_field :price_reais, value: (@service.price_cents ? @service.price_in_reais : 0), step: "0.01", min: 0, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>
      </div>

      <div class="flex items-center gap-2 pt-2">
        <%= f.check_box :active, class: "rounded border-slate-300 dark:border-slate-800 text-indigo-600 focus:ring-indigo-500" %>
        <%= f.label :active, "Serviço Ativo na Página Pública", class: "text-sm font-medium text-slate-700 dark:text-slate-300" %>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4">
        <%= link_to "Cancelar", admin_services_path, class: "px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white" %>
        <%= f.submit "Salvar Serviço", class: "px-6 py-2.5 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 cursor-pointer text-sm shadow-sm" %>
      </div>
    <% end %>
  </div>
</div>

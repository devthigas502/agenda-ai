<div>
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Catálogo de Serviços</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Defina preços e durações dos serviços oferecidos.</p>
    </div>
    <%= link_to new_admin_service_path, class: "px-4 py-2.5 rounded-xl font-semibold text-sm bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-500/25 transition-all flex items-center gap-2 cursor-pointer" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Novo Serviço
    <% end %>
  </div>

  <div class="bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 rounded-2xl backdrop-blur-xl overflow-hidden shadow-xs dark:shadow-none transition-colors">
    <div class="divide-y divide-slate-100 dark:divide-slate-800/60">
      <% @services.each do |service| %>
        <div class="p-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
          <div>
            <div class="flex items-center gap-3 mb-1">
              <h3 class="font-bold text-lg text-slate-900 dark:text-white"><%= service.name %></h3>
              <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold <%= service.active? ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700' %>">
                <%= service.active? ? "Ativo" : "Inativo" %>
              </span>
            </div>
            <% if service.description.present? %>
              <p class="text-xs text-slate-600 dark:text-slate-400 mb-2"><%= service.description %></p>
            <% end %>
            <div class="flex items-center gap-4 text-xs text-slate-500 dark:text-slate-400">
              <span>⏱ Duração: <strong class="text-slate-800 dark:text-slate-300 font-semibold"><%= service.formatted_duration %></strong></span>
              <span>💰 Preço: <strong class="text-emerald-600 dark:text-emerald-400 font-bold"><%= service.formatted_price %></strong></span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <%= link_to "Editar", edit_admin_service_path(service), class: "px-3 py-1.5 rounded-lg border border-slate-200 dark:border-slate-700 hover:bg-slate-100 dark:hover:bg-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-300 transition-colors" %>
            <%= button_to "Remover", admin_service_path(service), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "px-3 py-1.5 rounded-lg border border-rose-200 dark:border-rose-900/40 hover:bg-rose-50 dark:hover:bg-rose-950/40 text-xs font-semibold text-rose-600 dark:text-rose-400 cursor-pointer transition-colors" %>
          </div>
        </div>
      <% end %>

      <% if @services.empty? %>
        <div class="p-12 text-center text-slate-400 dark:text-slate-500">
          <p class="font-medium text-slate-600 dark:text-slate-400 mb-3">Nenhum serviço cadastrado.</p>
          <%= link_to "Cadastrar Primeiro Serviço", new_admin_service_path, class: "px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 text-white inline-block shadow-xs" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<div class="max-w-4xl mx-auto">
  <div class="flex items-center justify-between mb-8">
    <div>
      <div class="flex items-center gap-3">
        <%= link_to admin_professionals_path, class: "text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        <% end %>
        <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Horários de Atendimento</h1>
      </div>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Defina os dias e blocos de horários em que <span class="text-indigo-600 dark:text-indigo-400 font-semibold"><%= @professional.name %></span> está disponível.</p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Add Schedule Form -->
    <div class="bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800 p-6 rounded-3xl backdrop-blur-xl h-fit shadow-xs dark:shadow-none transition-colors">
      <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-4">Adicionar Horário</h3>

      <%= form_with model: [:admin, @professional, @schedule], class: "space-y-4" do |f| %>
        <div>
          <%= f.label :weekday, "Dia da Semana", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
          <%= f.select :weekday, [
            ["Segunda-feira", 1],
            ["Terça-feira", 2],
            ["Quarta-feira", 3],
            ["Quinta-feira", 4],
            ["Sexta-feira", 5],
            ["Sábado", 6],
            ["Domingo", 0]
          ], {}, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= f.label :starts_at, "Início", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
            <%= f.time_field :starts_at, required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-medium transition-colors" %>
          </div>
          <div>
            <%= f.label :ends_at, "Fim", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
            <%= f.time_field :ends_at, required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-medium transition-colors" %>
          </div>
        </div>

        <%= f.submit "Adicionar Bloco", class: "w-full py-3 px-4 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 cursor-pointer text-sm shadow-sm" %>
      <% end %>
    </div>

    <!-- Schedule List by Day -->
    <div class="lg:col-span-2 space-y-4">
      <% (0..6).to_a.rotate(1).each do |day_num| %>
        <% day_schedules = @schedules.select { |s| s.weekday == day_num } %>
        <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 backdrop-blur-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xs dark:shadow-none transition-colors">
          <div class="w-36 flex-shrink-0">
            <span class="font-bold text-sm text-slate-900 dark:text-white"><%= Schedule::DAY_NAMES[day_num] %></span>
          </div>

          <div class="flex-1 flex flex-wrap gap-2">
            <% if day_schedules.any? %>
              <% day_schedules.each do |schedule| %>
                <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/20 text-indigo-700 dark:text-indigo-300 text-xs font-mono font-semibold">
                  <span><%= schedule.starts_at.strftime("%H:%M") %> - <%= schedule.ends_at.strftime("%H:%M") %></span>
                  <%= button_to admin_professional_schedule_path(@professional, schedule), method: :delete, data: { turbo_confirm: "Remover este bloco?" }, class: "text-slate-400 hover:text-rose-600 dark:hover:text-rose-400 cursor-pointer transition-colors" do %>
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
                  <% end %>
                </div>
              <% end %>
            <% else %>
              <span class="text-xs text-slate-400 dark:text-slate-500 italic">Sem atendimento</span>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

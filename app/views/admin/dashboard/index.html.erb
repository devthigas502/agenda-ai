<div>
  <!-- Header Banner -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Painel de Controle</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Visão geral da agenda e métricas do seu negócio em tempo real.</p>
    </div>

    <div class="flex items-center gap-3">
      <%= link_to new_admin_booking_path, class: "px-4 py-2.5 rounded-xl font-semibold text-sm bg-gradient-to-r from-indigo-500 to-violet-600 hover:from-indigo-600 hover:to-violet-700 text-white shadow-lg shadow-indigo-500/25 transition-all flex items-center gap-2" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
        Novo Agendamento
      <% end %>
    </div>
  </div>

  <!-- KPI Metric Cards Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
    <!-- Card 1: Total Receita -->
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 backdrop-blur-xl shadow-xs dark:shadow-none transition-colors">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Receita Estimada</span>
        <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-600 dark:text-emerald-400 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-extrabold text-slate-900 dark:text-white">R$ <%= number_with_precision(@estimated_revenue, precision: 2, separator: ",", delimiter: ".") %></p>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Agendamentos confirmados e concluídos</p>
    </div>

    <!-- Card 2: Total Agendamentos -->
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 backdrop-blur-xl shadow-xs dark:shadow-none transition-colors">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Agendamentos Totais</span>
        <div class="w-8 h-8 rounded-lg bg-indigo-500/10 border border-indigo-500/20 text-indigo-600 dark:text-indigo-400 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-extrabold text-slate-900 dark:text-white"><%= @total_bookings_count %></p>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1"><%= @completed_count %> concluídos</p>
    </div>

    <!-- Card 3: Profissionais e Serviços -->
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 backdrop-blur-xl shadow-xs dark:shadow-none transition-colors">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Capacidade Ativa</span>
        <div class="w-8 h-8 rounded-lg bg-violet-500/10 border border-violet-500/20 text-violet-600 dark:text-violet-400 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-extrabold text-slate-900 dark:text-white"><%= @professionals_count %> <span class="text-sm font-normal text-slate-500 dark:text-slate-400">prof.</span> / <%= @services_count %> <span class="text-sm font-normal text-slate-500 dark:text-slate-400">serv.</span></p>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Configuração de catálogo</p>
    </div>

    <!-- Card 4: Taxa de Faltas -->
    <div class="p-5 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 backdrop-blur-xl shadow-xs dark:shadow-none transition-colors">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Cancelamentos e No-Show</span>
        <div class="w-8 h-8 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-600 dark:text-rose-400 flex items-center justify-center">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
      </div>
      <p class="text-2xl font-extrabold text-slate-900 dark:text-white"><%= @cancelled_count + @no_show_count %></p>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1"><%= @cancelled_count %> cancelados, <%= @no_show_count %> faltas</p>
    </div>
  </div>

  <!-- Today's Schedule Section -->
  <div class="bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 rounded-2xl backdrop-blur-xl overflow-hidden mb-8 shadow-xs dark:shadow-none transition-colors">
    <div class="p-6 border-b border-slate-200 dark:border-slate-800/60 flex items-center justify-between">
      <div>
        <h2 class="font-bold text-lg text-slate-900 dark:text-white">Agenda de Hoje (<%= I18n.l(Date.current, format: :short) %>)</h2>
        <p class="text-xs text-slate-500 dark:text-slate-400">Compromissos agendados para a data de hoje.</p>
      </div>
      <%= link_to "Ver Todos", admin_bookings_path, class: "text-xs font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300" %>
    </div>

    <% if @today_bookings.any? %>
      <div class="divide-y divide-slate-100 dark:divide-slate-800/60">
        <% @today_bookings.each do |booking| %>
          <div class="p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:bg-slate-50 dark:hover:bg-slate-800/30 transition-colors">
            <div class="flex items-start gap-4">
              <div class="px-3 py-1.5 rounded-xl bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/20 text-indigo-600 dark:text-indigo-400 text-xs font-bold font-mono">
                <%= booking.starts_at.strftime("%H:%M") %> - <%= booking.ends_at.strftime("%H:%M") %>
              </div>
              <div>
                <h4 class="font-bold text-sm text-slate-900 dark:text-white"><%= booking.client.name %></h4>
                <p class="text-xs text-slate-600 dark:text-slate-400"><%= booking.service.name %> • com <span class="text-slate-800 dark:text-slate-300 font-medium"><%= booking.professional.name %></span></p>
                <p class="text-[11px] text-slate-500"><%= booking.client.phone %></p>
              </div>
            </div>

            <div class="flex items-center gap-3">
              <span class="px-2.5 py-1 rounded-full text-xs font-semibold
                <%= case booking.status
                    when 'confirmed' then 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20'
                    when 'completed' then 'bg-blue-500/10 text-blue-600 dark:text-blue-400 border border-blue-500/20'
                    when 'cancelled' then 'bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20'
                    when 'no_show' then 'bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20'
                    else 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200 dark:border-slate-700'
                    end %>">
                <%= booking.status.upcase %>
              </span>

              <% if booking.pending? %>
                <%= button_to "Confirmar", confirm_admin_booking_path(booking), method: :patch, class: "px-3 py-1 text-xs font-semibold rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white cursor-pointer" %>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="p-12 text-center text-slate-400 dark:text-slate-500">
        <svg class="w-12 h-12 mx-auto text-slate-400 dark:text-slate-600 mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <p class="font-medium text-slate-600 dark:text-slate-400">Nenhum agendamento para hoje ainda.</p>
        <p class="text-xs mt-1 text-slate-500">Compartilhe sua página pública para receber reservas!</p>
      </div>
    <% end %>
  </div>
</div>

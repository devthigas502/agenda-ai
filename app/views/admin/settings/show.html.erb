<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight mb-2">Configurações do Negócio</h1>
  <p class="text-sm text-slate-600 dark:text-slate-400 mb-8">Personalize a URL pública e dados de contato.</p>

  <div class="bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800 p-8 rounded-3xl backdrop-blur-xl space-y-6 shadow-sm dark:shadow-none transition-colors">
    <!-- Public Link Banner -->
    <div class="p-4 rounded-2xl bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/20 text-indigo-800 dark:text-indigo-300 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs">
      <div>
        <span class="font-bold uppercase tracking-wider block text-[10px] text-indigo-600 dark:text-indigo-400">Sua URL Pública de Agendamento</span>
        <code class="font-mono text-sm text-slate-900 dark:text-white font-semibold"><%= request.base_url %>/<%= @account.slug %></code>
      </div>
      <%= link_to public_booking_page_path(slug: @account.slug), target: "_blank", class: "px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-semibold text-center whitespace-nowrap shadow-xs cursor-pointer" do %>
        Acessar Página ↗
      <% end %>
    </div>

    <%= form_with model: @account, url: admin_settings_path, method: :patch, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :name, "Nome do Negócio", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
        <%= f.text_field :name, required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
      </div>

      <div>
        <%= f.label :slug, "Slug da URL Pública (identificador único)", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
        <div class="flex items-center">
          <span class="px-3 py-3 rounded-l-xl bg-slate-100 dark:bg-slate-900 border border-r-0 border-slate-200 dark:border-slate-800 text-slate-500 dark:text-slate-400 text-xs font-mono"><%= request.base_url %>/</span>
          <%= f.text_field :slug, required: true, class: "w-full px-4 py-3 rounded-r-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-mono transition-colors" %>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <%= f.label :phone, "Telefone Comercial", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
          <%= f.telephone_field :phone, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>
        <div>
          <%= f.label :email, "E-mail de Contato", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
          <%= f.email_field :email, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>
      </div>

      <div>
        <%= f.label :timezone, "Fuso Horário", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
        <%= f.time_zone_select :timezone, nil, {}, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
      </div>

      <div class="pt-4 flex justify-end">
        <%= f.submit "Salvar Configurações", class: "px-6 py-2.5 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 cursor-pointer text-sm shadow-sm" %>
      </div>
    <% end %>

    <!-- Theme Preference Section -->
    <div class="pt-6 border-t border-slate-200 dark:border-slate-800/80">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div>
          <h3 class="text-sm font-bold text-slate-900 dark:text-white">Aparência do Sistema</h3>
          <p class="text-xs text-slate-500 dark:text-slate-400">Escolha o tema de visualização (Claro, Escuro ou Automático).</p>
        </div>

        <%= render "shared/theme_selector" %>
      </div>
    </div>
  </div>
</div>

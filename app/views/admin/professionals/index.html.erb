<div>
  <div class="flex items-center justify-between mb-8">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Profissionais</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Gerencie a equipe e seus horários de atendimento.</p>
    </div>
    <%= link_to new_admin_professional_path, class: "px-4 py-2.5 rounded-xl font-semibold text-sm bg-indigo-600 hover:bg-indigo-500 text-white shadow-md shadow-indigo-500/25 transition-all flex items-center gap-2 cursor-pointer" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
      Novo Profissional
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @professionals.each do |prof| %>
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/90 dark:border-slate-800/80 backdrop-blur-xl flex flex-col justify-between shadow-xs dark:shadow-none transition-colors">
        <div>
          <div class="flex items-start justify-between mb-4">
            <div class="w-12 h-12 rounded-full bg-gradient-to-tr from-indigo-500 to-violet-600 flex items-center justify-center font-bold text-lg text-white shadow-md shadow-indigo-500/20">
              <%= prof.name.first %>
            </div>
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold <%= prof.active? ? 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20' : 'bg-slate-100 dark:bg-slate-800 text-slate-500 dark:text-slate-400 border border-slate-200 dark:border-slate-700' %>">
              <%= prof.active? ? "Ativo" : "Inativo" %>
            </span>
          </div>

          <h3 class="font-bold text-lg text-slate-900 dark:text-white mb-1"><%= prof.name %></h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-2"><%= prof.email || prof.phone || "Sem contato" %></p>
          <% if prof.bio.present? %>
            <p class="text-xs text-slate-600 dark:text-slate-400 line-clamp-2 mb-4"><%= prof.bio %></p>
          <% end %>

          <div class="text-xs text-slate-500 dark:text-slate-400 space-y-1 mb-6">
            <p><span class="font-semibold text-slate-800 dark:text-slate-300"><%= prof.services.count %></span> serviços vinculados</p>
            <p><span class="font-semibold text-slate-800 dark:text-slate-300"><%= prof.schedules.count %></span> blocos de horários configurados</p>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-slate-100 dark:border-slate-800/60 text-xs">
          <%= link_to "Gerenciar Horários", admin_professional_schedules_path(prof), class: "font-semibold text-indigo-600 dark:text-indigo-400 hover:text-indigo-700 dark:hover:text-indigo-300" %>
          <div class="flex items-center gap-3">
            <%= link_to "Editar", edit_admin_professional_path(prof), class: "text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors" %>
            <%= button_to "Remover", admin_professional_path(prof), method: :delete, data: { turbo_confirm: "Tem certeza?" }, class: "text-rose-500 hover:text-rose-700 dark:text-rose-400 dark:hover:text-rose-300 cursor-pointer" %>
          </div>
        </div>
      </div>
    <% end %>

    <% if @professionals.empty? %>
      <div class="col-span-full p-12 text-center bg-white dark:bg-slate-900/40 rounded-2xl border border-slate-200 dark:border-slate-800 shadow-xs">
        <p class="text-slate-600 dark:text-slate-400 font-medium mb-3">Nenhum profissional cadastrado ainda.</p>
        <%= link_to "Cadastrar Primeiro Profissional", new_admin_professional_path, class: "px-4 py-2 rounded-xl text-xs font-semibold bg-indigo-600 text-white inline-block shadow-xs" %>
      </div>
    <% end %>
  </div>
</div>

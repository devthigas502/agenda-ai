<div class="max-w-5xl mx-auto space-y-8">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Assinatura & Faturamento</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">Gerencie seu plano, pagamentos seguros com Stripe e faturas.</p>
    </div>

    <% if @account.stripe_customer_id.present? %>
      <div>
        <%= button_to portal_admin_subscription_path, method: :post, class: "px-4 py-2.5 rounded-xl font-semibold text-sm bg-slate-100 hover:bg-slate-200 dark:bg-slate-800 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-slate-700 shadow-xs transition-all flex items-center gap-2 cursor-pointer" do %>
          <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg>
          Gerenciar Cartão e Faturas no Stripe ↗
        <% end %>
      </div>
    <% end %>
  </div>

  <!-- Subscription Status Banner Card -->
  <div class="p-6 sm:p-8 rounded-3xl bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800 backdrop-blur-xl shadow-sm dark:shadow-none transition-colors">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-6">
      <div class="space-y-2">
        <div class="flex items-center gap-3">
          <span class="text-xs font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Status da Conta</span>
          <% if @account.subscription_active? %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
              Assinatura Ativa
            </span>
          <% elsif @account.trial_active? %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 border border-indigo-500/20">
              <span class="w-1.5 h-1.5 rounded-full bg-indigo-500 animate-pulse"></span>
              Período de Testes (<%= @account.trial_days_left %> dias restantes)
            </span>
          <% elsif @account.subscription_past_due? %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
              Pagamento Pendente
            </span>
          <% else %>
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-rose-500/10 text-rose-600 dark:text-rose-400 border border-rose-500/20">
              Teste Expirado
            </span>
          <% end %>
        </div>

        <h3 class="text-2xl font-extrabold text-slate-900 dark:text-white">
          <%= @account.plan_name %>
        </h3>

        <p class="text-xs text-slate-500 dark:text-slate-400">
          <% if @account.subscription_current_period_end.present? %>
            Renovação / Próxima cobrança em <strong class="text-slate-800 dark:text-slate-200"><%= I18n.l(@account.subscription_current_period_end.to_date, format: :long) %></strong>.
            <% if @account.subscription_cancel_at_period_end %>
              <span class="text-amber-500 font-semibold">(Cancelamento programado ao fim do período)</span>
            <% end %>
          <% elsif @account.trial_active? %>
            Seu período de avaliação gratuita vai até <strong class="text-slate-800 dark:text-slate-200"><%= I18n.l(@account.trial_ends_at.to_date, format: :long) %></strong>.
          <% end %>
        </p>
      </div>

      <div class="flex items-center gap-3">
        <% if @account.subscription_active? %>
          <%= button_to portal_admin_subscription_path, method: :post, class: "w-full sm:w-auto px-5 py-3 rounded-2xl font-bold text-sm bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-100 dark:hover:bg-white dark:text-slate-900 transition-all cursor-pointer shadow-md" do %>
            Gerenciar Assinatura
          <% end %>
        <% else %>
          <a href="#planos" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl font-bold text-sm bg-gradient-to-r from-indigo-500 via-violet-600 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white shadow-lg shadow-indigo-500/25 transition-all text-center">
            Escolher um Plano
          </a>
        <% end %>
      </div>
    </div>
  </div>

  <!-- Plans Selection Grid -->
  <div id="planos" class="space-y-6 pt-4">
    <div class="text-center max-w-2xl mx-auto space-y-2">
      <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white tracking-tight">Escolha o Plano Ideal para seu Negócio</h2>
      <p class="text-slate-600 dark:text-slate-400 text-sm">Sem taxas ocultas, cancele quando quiser com total flexibilidade.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-stretch pt-4">
      <!-- Plano Mensal -->
      <div class="rounded-3xl p-8 bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800 flex flex-col justify-between shadow-sm dark:shadow-none hover:border-indigo-300 dark:hover:border-slate-700 transition-all relative">
        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-50 dark:bg-indigo-950/40 px-3 py-1 rounded-full border border-indigo-200 dark:border-indigo-500/30">
              <%= StripePlan::MONTHLY[:name] %>
            </span>
          </div>

          <div class="flex items-baseline gap-2 mb-2">
            <span class="text-4xl font-extrabold text-slate-900 dark:text-white"><%= StripePlan::MONTHLY[:price_display] %></span>
            <span class="text-sm text-slate-500 dark:text-slate-400 font-medium">/ mês</span>
          </div>
          <p class="text-xs text-slate-500 dark:text-slate-400 mb-6">Cobrado mensalmente. Cancele a qualquer momento.</p>

          <ul class="space-y-3.5 mb-8 text-sm">
            <% StripePlan::MONTHLY[:features].each do |feature| %>
              <li class="flex items-start gap-3 text-slate-700 dark:text-slate-300">
                <svg class="w-5 h-5 text-emerald-500 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span><%= feature %></span>
              </li>
            <% end %>
          </ul>
        </div>

        <div>
          <%= button_to admin_subscription_path(plan_id: "monthly"), method: :post, class: "w-full py-4 px-6 rounded-2xl font-bold text-sm bg-slate-900 hover:bg-slate-800 text-white dark:bg-slate-800 dark:hover:bg-slate-700 dark:text-white border border-slate-700/50 shadow-sm transition-all cursor-pointer text-center block", data: { turbo: false } do %>
            <%= @account.subscription_plan == "monthly" && @account.subscription_active? ? "Plano Atual (Renovar)" : "Assinar Plano Mensal" %>
          <% end %>
        </div>
      </div>

      <!-- Plano Anual (Em Destaque) -->
      <div class="rounded-3xl p-8 bg-gradient-to-b from-indigo-50/70 via-white to-white dark:from-indigo-950/40 dark:via-slate-900/90 dark:to-slate-900/90 border-2 border-indigo-500/80 dark:border-indigo-500 flex flex-col justify-between shadow-xl shadow-indigo-500/10 relative">
        <!-- Floating Highlight Badge -->
        <div class="absolute -top-3.5 right-6 bg-gradient-to-r from-indigo-500 to-violet-600 text-white text-xs font-extrabold px-3.5 py-1 rounded-full shadow-md uppercase tracking-wide">
          <%= StripePlan::YEARLY[:badge] %>
        </div>

        <div>
          <div class="flex items-center justify-between mb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400 bg-indigo-100 dark:bg-indigo-950/60 px-3 py-1 rounded-full border border-indigo-300 dark:border-indigo-500/40">
              <%= StripePlan::YEARLY[:name] %>
            </span>
          </div>

          <div class="flex items-baseline gap-2 mb-1">
            <span class="text-4xl font-extrabold text-slate-900 dark:text-white"><%= StripePlan::YEARLY[:price_display] %></span>
            <span class="text-sm text-slate-500 dark:text-slate-400 font-medium">/ ano</span>
          </div>
          <p class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 mb-6">
            <%= StripePlan::YEARLY[:savings_display] %> — apenas <%= StripePlan::YEARLY[:monthly_equivalent] %>
          </p>

          <ul class="space-y-3.5 mb-8 text-sm">
            <% StripePlan::YEARLY[:features].each do |feature| %>
              <li class="flex items-start gap-3 text-slate-800 dark:text-slate-200">
                <svg class="w-5 h-5 text-indigo-600 dark:text-indigo-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
                <span class="font-medium"><%= feature %></span>
              </li>
            <% end %>
          </ul>
        </div>

        <div>
          <%= button_to admin_subscription_path(plan_id: "yearly"), method: :post, class: "w-full py-4 px-6 rounded-2xl font-bold text-sm bg-gradient-to-r from-indigo-500 via-violet-600 to-purple-600 hover:from-indigo-600 hover:to-purple-700 text-white shadow-xl shadow-indigo-500/30 transition-all cursor-pointer text-center block transform hover:-translate-y-0.5", data: { turbo: false } do %>
            <%= @account.subscription_plan == "yearly" && @account.subscription_active? ? "Plano Atual (Renovar)" : "Assinar Plano Anual (42% OFF)" %>
          <% end %>
        </div>
      </div>
    </div>
  </div>

  <!-- Trust and Guarantee Footer -->
  <div class="p-6 rounded-2xl bg-slate-100/70 dark:bg-slate-900/40 border border-slate-200 dark:border-slate-800 text-center text-xs text-slate-500 dark:text-slate-400 flex flex-col sm:flex-row items-center justify-center gap-6">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
      <span>Pagamentos 100% Criptografados via Stripe</span>
    </div>
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-indigo-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <span>Sem carência ou multas rescisórias</span>
    </div>
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      <span>Suporte via WhatsApp e E-mail</span>
    </div>
  </div>
</div>

<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-slate-900 dark:text-white mb-6">Novo Agendamento Manual</h1>

  <div class="bg-white dark:bg-slate-900/80 border border-slate-200/90 dark:border-slate-800 p-8 rounded-3xl backdrop-blur-xl shadow-sm dark:shadow-none transition-colors">
    <% if @errors&.any? %>
      <div class="mb-6 p-4 rounded-xl bg-rose-500/10 border border-rose-500/30 text-rose-600 dark:text-rose-400 text-sm">
        <ul class="list-disc list-inside space-y-1">
          <% @errors.each do |err| %>
            <li><%= err %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <%= form_with scope: :booking, url: admin_bookings_path, class: "space-y-5" do |f| %>
      <div>
        <%= f.label :professional_id, "Profissional", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
        <%= f.collection_select :professional_id, @professionals, :id, :name, { prompt: "Selecione..." }, required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
      </div>

      <div>
        <%= f.label :service_id, "Serviço", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
        <%= f.collection_select :service_id, @services, :id, :name, { prompt: "Selecione..." }, required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
      </div>

      <div>
        <%= f.label :starts_at, "Data e Horário de Início", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
        <%= f.datetime_field :starts_at, required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm font-medium transition-colors" %>
      </div>

      <div class="border-t border-slate-200 dark:border-slate-800 pt-4 space-y-4">
        <h4 class="text-sm font-semibold text-slate-900 dark:text-slate-200">Dados do Cliente</h4>

        <div>
          <%= f.label :client_name, "Nome do Cliente", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
          <%= f.text_field :client_name, required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <%= f.label :client_phone, "Telefone / WhatsApp", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
            <%= f.telephone_field :client_phone, required: true, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
          </div>

          <div>
            <%= f.label :client_email, "E-mail (opcional)", class: "block text-xs font-semibold text-slate-700 dark:text-slate-300 uppercase tracking-wider mb-2" %>
            <%= f.email_field :client_email, class: "w-full px-4 py-3 rounded-xl bg-slate-50/70 dark:bg-slate-950/70 border border-slate-200 dark:border-slate-800 text-slate-900 dark:text-white placeholder-slate-400 dark:placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-indigo-500 text-sm transition-colors" %>
          </div>
        </div>
      </div>

      <div class="flex items-center justify-end gap-3 pt-4">
        <%= link_to "Cancelar", admin_bookings_path, class: "px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-600 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white" %>
        <%= f.submit "Criar Agendamento", class: "px-6 py-2.5 rounded-xl font-bold text-white bg-indigo-600 hover:bg-indigo-500 cursor-pointer text-sm shadow-sm" %>
      </div>
    <% end %>
  </div>
</div>
